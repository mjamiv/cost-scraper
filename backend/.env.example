# Snowflake Connection
SF_ACCOUNT=TB78941
SF_USER=MICHAEL.MARTELLO@KIEWIT.COM
SF_ROLE=PROD_KDS_CONSUMPTION_SEM_R_AR
SF_WAREHOUSE=PROD_ENT_CONS_BI_BULK_WH

# ============================================
# SNOWFLAKE AUTHENTICATION - Choose ONE method:
# ============================================

# Option 1: SSO/Browser Auth (RECOMMENDED for local dev)
# Opens browser to authenticate with your Kiewit SSO
SF_AUTHENTICATOR=externalbrowser

# Option 2: Password Auth (simple but less secure)
# SF_PASSWORD=your_snowflake_password

# Option 3: Key-pair Auth (for production/automation)
# SF_PRIVATE_KEY_B64=<base64 encoded private key>
# SF_PRIVATE_KEY_PASSPHRASE=<passphrase if key is encrypted>

# ============================================
# Connection Pooling
# ============================================
SF_POOL_SIZE=5
SF_POOL_TIMEOUT=30

# ============================================
# API Authentication (JWT)
# ============================================
# Set to false to disable auth (development mode)
AUTH_ENABLED=true

# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Token expiry in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# Optional: API key for service-to-service auth
# API_KEY=your-api-key-here

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============================================
# OpenAI API (for voice chatbot)
# Get your key at: https://platform.openai.com/api-keys
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# CORS - Origins allowed to call the API
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500
